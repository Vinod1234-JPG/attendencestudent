# ==============================================================================
# MRF Event Attendance Tracker - Environment Configuration
# ==============================================================================
# Configure with your project credentials from your Supabase Dashboard:
# Project Settings -> API

# Public Supabase URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Privileged Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
# Used for server-side administrative tasks, migrations, and authorized private photo signing
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL (for redirects, canonical origin, and audit)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Event and Institution identity
NEXT_PUBLIC_ORGANIZATION_NAME="Maharaja Research Foundation"
NEXT_PUBLIC_APP_TITLE="MRF Event Attendance Tracker"

# ------------------------------------------------------------------------------
# Local development admin login (ONLY used when Supabase is not configured)
# In production, admins are Supabase Auth users with an admin row in public.profiles.
# ------------------------------------------------------------------------------
# ADMIN_EMAIL=you@example.org
# ADMIN_PASSWORD=choose-a-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_SESSION_SECRET=
